						<font fontName="BancoPopolareFont" size="9" isBold="false" isItalic="true"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<textFieldExpression><![CDATA["I Valori Agricoli Medi (VAM) sono determinati ogni anno, entro il 31 gennaio, dalla Commissione Provinciale Espropri nell'ambito delle singole regioni agrarie, con riferimento ai valori dei terreni considerati liberi da vincoli di contratti agrari, secondo i tipi di coltura effettivamente praticati, e rilevati nell'anno solare precedente. I valori, espressi in euro per ettaro, vengono pubblicati sui Bollettini Ufficiali Regionali (BUR)."]]></textFieldExpression>
				</textField>
