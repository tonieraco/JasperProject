					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="BancoPopolareFont" size="9"/>
					</textElement>
					<textFieldExpression><![CDATA["Qualora sia necessario compilare l'ADD-ON TASSONOMICO il Provider dovrà dare chiara ed effettiva dimostrazione dell’apprezzamento del rischio fisico comunicato dall'Istituto nella determinazione del valore di mercato, con qualsiasi metodo di stima utilizzato o ulteriori specifiche in merito. Si rimandano gli approfondimenti al questionario compilato con foto dimostrative da storicizzarsi tra gli allegati."]]></textFieldExpression>
