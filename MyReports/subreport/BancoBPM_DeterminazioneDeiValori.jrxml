						<font fontName="BancoPopolareFont" size="9" isBold="false" isItalic="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Il valore determinato con questo metodo, che  individua il prezzo al quale questo asset verrebbe scambiato sul mercato, NON può essere utilizzato ai fini della concessione di finanziamenti ipotecari o fondiari in quanto, in questi casi, \"..il Valore di Mercato dovrà fare essenzialmente riferimento alla componente immobiliare e a tutto ciò che sia stabilmente ed indissolubilmente connesso al terreno / fabbricato e quindi alla relativa ipoteca\". (Cfr. secondo capoverso di pag. 8 delle Linee Guida ABI, Aprile 2022)"]]></textFieldExpression>
