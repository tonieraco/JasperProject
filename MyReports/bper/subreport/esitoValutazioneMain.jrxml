					</box>
					<textElement textAlignment="Left" verticalAlignment="Middle">
						<font fontName="BancoPopolareFont" size="10" isBold="true"/>
					</textElement>
				</textField>
			</frame>
		</band>
	</detail>
</jasperReport>
